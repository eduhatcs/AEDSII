/T (public boolean search\(int elem\){     int i = elem % 6; //hash da T1     if\(T1[i] == null\){       return false;     } else if\(T1[i].elem == elem\){       return true;     } else {       i = elem % 3; //hash da T2       if\(i == 0\){         i = elem % 5; //hash da T3         if\(T3[i] == null\){           return false;         } else if \(T3[i].elem == elem\){           return true;         } else {           i = elem - 1 % 5; //rehash da T3           if\(T3[i] == null\){             return false;           } else if\(T3[i].elem == elem\){             return true;           }else {             arvoreBinaria.search\(elem\);           }         }       }else if \(i == 1\){         lista.search\(elem\);       }else{ //if \(i == 2\)         arvoreAVL.search\(elem\);       }     }   })
